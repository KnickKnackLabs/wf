#!/usr/bin/env bash
#MISE description="Drop the first N line records"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/wf.bash"

usage() {
  cat <<'USAGE'
Usage: wf flow drop N
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

[ "$#" -eq 1 ] || wf_die "usage: wf flow drop N"
limit="$1"
[[ "$limit" =~ ^[0-9]+$ ]] || wf_die "N must be a non-negative integer"

seen=0
while IFS= read -r line; do
  if [ "$seen" -lt "$limit" ]; then
    seen=$((seen + 1))
    continue
  fi
  printf '%s\n' "$line"
done

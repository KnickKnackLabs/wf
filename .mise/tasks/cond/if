#!/usr/bin/env bash
#MISE description="Route line records through then/else commands using a predicate command"
#USAGE example "wf emit 1 2 | wf cond if 'grep -q 2' --then 'sed s/^/two:/' --else cat" header="Route by predicate command"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/wf.bash"

usage() {
  cat <<'USAGE'
Usage: wf cond if --pred COMMAND --then COMMAND [--else COMMAND]

The predicate receives each input line on stdin and in $WF_RECORD. Exit 0 means
true. Branch commands receive the selected line on stdin and in $WF_RECORD.

Example:
  wf emit 1 2 3 4 \
    | wf cond if \
        --pred 'awk "{ exit !(\$1 % 2 == 0) }"' \
        --then 'sed "s/^/even: /"' \
        --else 'sed "s/^/odd: /"'
USAGE
}

predicate=""
then_command=""
else_command=""
record_mode="line"

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --record)
      [ "$#" -ge 2 ] || wf_die "--record requires a value"
      record_mode="$2"
      shift 2
      ;;
    -p|--pred|--predicate)
      [ "$#" -ge 2 ] || wf_die "$1 requires a command"
      predicate="$2"
      shift 2
      ;;
    -t|--then)
      [ "$#" -ge 2 ] || wf_die "--then requires a command"
      then_command="$2"
      shift 2
      ;;
    -e|--else)
      [ "$#" -ge 2 ] || wf_die "--else requires a command"
      else_command="$2"
      shift 2
      ;;
    *)
      if [ -z "$predicate" ]; then
        predicate="$1"
        shift
      else
        wf_die "unexpected argument: $1"
      fi
      ;;
  esac
done

[ "$record_mode" = "line" ] || wf_die "only --record line is supported for now"
[ -n "$predicate" ] || wf_die "missing --pred COMMAND"
[ -n "$then_command" ] || wf_die "missing --then COMMAND"

while IFS= read -r record || [ -n "$record" ]; do
  if wf_test_line_command "$predicate" "$record"; then
    wf_run_line_command "$then_command" "$record"
  elif [ -n "$else_command" ]; then
    wf_run_line_command "$else_command" "$record"
  fi
done

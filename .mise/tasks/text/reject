#!/usr/bin/env bash
#MISE description="Drop text lines matching a Bash regular expression"
#USAGE example "wf emit alpha beta | wf text reject '^b'" header="Drop text matching regex"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/wf.bash"

usage() {
  cat <<'USAGE'
Usage: wf text reject REGEX

Drops lines where [[ $line =~ REGEX ]] is true.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

[ "$#" -eq 1 ] || wf_die "usage: wf text reject REGEX"
pattern="$1"

while IFS= read -r line || [ -n "$line" ]; do
  if ! [[ "$line" =~ $pattern ]]; then
    printf '%s\n' "$line"
  fi
done

#!/usr/bin/env bash
#MISE description="Run a side-effect command on a copy of stdin while passing stdin through"
#USAGE example "wf emit a b | wf tap 'wc -l'" header="Observe without changing stdout"
set -euo pipefail

source "$MISE_CONFIG_ROOT/lib/wf.bash"

usage() {
  cat <<'USAGE'
Usage: wf tap COMMAND

COMMAND receives a copy of stdin. Its stdout is redirected to stderr so the main
pipeline remains unchanged.
USAGE
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

[ "$#" -eq 1 ] || wf_die "usage: wf tap COMMAND"
command_string="$1"

tmp_dir="$(mktemp -d)"
# shellcheck disable=SC2329 # invoked by the EXIT trap below
cleanup() {
  rm -rf "$tmp_dir"
}
trap cleanup EXIT

fifo="$tmp_dir/tap"
mkfifo "$fifo"
bash -lc "$command_string" < "$fifo" >&2 &
pid="$!"

fd=10
eval "exec $fd>\"\$fifo\""
status=0

while IFS= read -r line || [ -n "$line" ]; do
  printf '%s\n' "$line"
  if ! printf '%s\n' "$line" >&"$fd"; then
    status=1
    break
  fi
done

eval "exec $fd>&-"
if ! wait "$pid"; then
  status=1
fi

exit "$status"
